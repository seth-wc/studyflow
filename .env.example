# Firebase project config.
#
# Get these from: Firebase Console -> Project settings (gear icon) ->
# General tab -> "Your apps" -> the Web app -> SDK setup and configuration.
#
# These values are NOT secret. They only tell the app which Firebase project
# to talk to — they don't grant access to anything by themselves. The actual
# access control lives in firestore.rules (only a signed-in user can read or
# write their own data). It's still fine to keep them out of the committed
# .env.local file, mainly so each environment (your machine, CI) can point at
# a different project if needed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave unset (or "false") for normal use — the app will talk to your real
# Firebase project. Set to "true" only when running local Firebase emulators
# for testing.
VITE_USE_FIREBASE_EMULATOR=
