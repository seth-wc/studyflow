rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own single data document.
    // This is the real privacy boundary — not the client config being public.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Off the Clock's Photo Forum: the one place in this app where users
    // see each other's data. Any signed-in user can read every post, but
    // can only create a post as themselves (authorUid must match their own
    // uid) and can only edit/delete posts they authored. Field checks on
    // create are a light sanity net, not a substitute for real validation.
    match /forumPosts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 120
        && request.resource.data.driveLink is string
        && request.resource.data.driveLink.size() > 0
        && request.resource.data.driveLink.size() <= 2000
        && request.resource.data.createdAt is string;

      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;

      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    // Device push-notification tokens, one doc per token (doc id == the
    // token itself, which naturally de-dupes re-registration). Only the
    // owning user can create/update/delete their own token, and no client
    // ever reads this collection -- only the Cloud Function that sends
    // pushes reads it, via the Admin SDK, which bypasses these rules
    // entirely. So reads are denied outright; there's no legitimate
    // client-side reason to list other users' (or even your own) tokens.
    match /pushTokens/{tokenId} {
      allow read: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
